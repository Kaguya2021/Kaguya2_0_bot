# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Строка подключения к Neon/Postgres (обязательно)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ID администраторов через запятую
ADMIN_IDS=111111111,222222222

# Секрет вебхука Telegram (1-256 символов: A-Z a-z 0-9 _ -).
# Обязателен в продакшене: без него /api/webhook не проверяет подпись запросов.
WEBHOOK_SECRET=

# Публичный адрес сервиса (Render подставляет автоматически)
RENDER_EXTERNAL_URL=https://your-service.onrender.com

# Порт HTTP-сервера (Render подставляет автоматически)
PORT=3000

# true — локальный запуск через polling (без webhook), например на Windows
USE_POLLING=false
