# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Строка подключения к Neon/Postgres (обязательно)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ID администраторов через запятую
ADMIN_IDS=111111111,222222222

# Секрет вебхука Telegram (1-256 символов: A-Z a-z 0-9 _ -).
# Обязателен в продакшене: без него /api/webhook не проверяет подпись запросов.
WEBHOOK_SECRET=

# Публичный адрес сервиса (Render подставляет автоматически)
RENDER_EXTERNAL_URL=https://your-service.onrender.com

# Порт HTTP-сервера (Render подставляет автоматически)
PORT=3000

# true — локальный запуск через polling (без webhook), например на Windows
USE_POLLING=false

# --- Фаза 2: фидбек и публикации в канал (опционально) ---

# ID канала для публикаций: -100... или @kaguya_2_0_bots. Бот должен быть админом канала
# с правом публикации. Пост уходит в канал ТОЛЬКО после нажатия админом кнопки
# «Опубликовать» на превью. Не задан — публикация в канал запрещена.
TARGET_CHANNEL_ID=

# ID привязанной группы обсуждений канала (-100...). Узнать: добавить бота в группу
# и отправить там /chatid (от админа из ADMIN_IDS). Боту нужен доступ к сообщениям
# группы (права админа или отключённый privacy mode в @BotFather).
# Не задан — сбор комментариев выключен.
DISCUSSION_GROUP_ID=

# --- Фаза 3Б: Gemini AI (.ai / .autoai / .dialog / .kawaii) (опционально) ---

# API-ключ Google AI Studio. Не задан — ИИ-команды отвечают владельцу, что ИИ не настроен.
GEMINI_API_KEY=

# Модель Gemini (по умолчанию gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Дневной лимит ИИ-запросов на владельца (UTC-сутки; админы из ADMIN_IDS без лимита)
AI_DAILY_LIMIT=25
